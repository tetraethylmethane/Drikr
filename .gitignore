# Dependencies
node_modules/
# package-lock.json is intentionally tracked: EAS resolves dependencies in the
# cloud, so without a committed lockfile a build can pull different versions
# than the ones verified locally.

# Expo
.expo/
dist/
web-build/

# Native — android/ and ios/ are generated by `expo prebuild` (Continuous Native
# Generation). EAS regenerates them in the cloud, so they are not tracked.
# Anchored to the root: an unanchored `android/` also matched
# modules/drone-link/android/, so EAS never uploaded the native module's code
# and the build silently shipped without it.
/android/
/ios/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Macros
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Misc
.env
.env.local
.env.*.local

# TypeScript
*.tsbuildinfo


# Claude Code
CLAUDE.md
CLAUDE.local.md
.claude/
