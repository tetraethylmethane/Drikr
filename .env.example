# Drikr runtime configuration
#
# TEMPLATE - this file IS tracked in git. Copy it to .env and fill in your keys:
#   cp .env.example .env
# Never put a real secret in this file. Restart Metro with `npx expo start -c` after any change here —
# app.config.js is only read at startup, so edits are invisible until a cache clear.
#
# EVERY VARIABLE BELOW IS OPTIONAL. With an empty file the app still runs fully:
# telemetry comes from the on-device simulator, weather from Open-Meteo (no key
# needed), and Kisan Mitra answers from the on-device decision engine.
#
# Set only what you need:
#   nothing          -> simulator + offline assistant. Fine for a demo.
#   GEMINI_API_KEY   -> Kisan Mitra answers via a cloud LLM instead of on-device.
#   API_BASE_URL     -> switches telemetry from simulator to real sensor hardware.


# ---------------------------------------------------------------------------
# Kisan Mitra assistant (optional)
# ---------------------------------------------------------------------------
# Set EITHER of these to route the assistant through a cloud model. Gemini wins if
# both are set. Leave both blank and the assistant uses on-device intent matching
# over the decision engine — which is the path that works with no signal, so a blank
# value here is a legitimate production choice, not a broken one.
#
# Gemini key:  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI key:  https://platform.openai.com/api-keys
OPENAI_API_KEY=


# ---------------------------------------------------------------------------
# Mandi prices — data.gov.in (optional; a working public key is already built in)
# ---------------------------------------------------------------------------
# The Market screen works without these: src/config/env.ts falls back to the public
# demo key below. Override them if you hit rate limits and want your own key from
# https://data.gov.in/user/register
DATA_GOV_API_KEY=579b464db66ec23bdd000001e19e51f7932a45cd5b94455207ab83ea

# Dataset: "Current Daily Price of Various Commodities from Various Markets (Mandi)"
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070


# ---------------------------------------------------------------------------
# Sensor backend (optional)
# ---------------------------------------------------------------------------
# Leave BLANK to run on the simulator. Setting this makes telemetrySource() report
# 'hardware' and the app will fetch from /telemetry/plots/:id/latest instead of
# simulating — so only set it when a real gateway is reachable, or the live tiles
# will sit empty.
#
# Use your machine's LAN IP, never localhost: a phone resolves localhost to itself.
# This machine's Wi-Fi address is currently 172.17.115.200.
# Example: API_BASE_URL=http://172.17.115.200:5000
API_BASE_URL=


# ---------------------------------------------------------------------------
# Firebase (phone + PIN auth)
# ---------------------------------------------------------------------------
# Firebase console -> Project settings -> General -> Your apps -> Web app.
# Paste the values from the firebaseConfig object.
#
# Leave blank and auth still works: sign-in falls back to a PIN stored on the
# device. Filling these in is what makes accounts sync across devices.
#
# You must also create the Firestore database in the console, or requests fail
# with 403 CONSUMER_INVALID even with correct keys here.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=



# ---------------------------------------------------------------------------
# EAS cloud builds do NOT see this file
# ---------------------------------------------------------------------------
# .env is gitignored, so it is never uploaded to EAS Build. A cloud build resolves
# these as empty unless you provide them another way:
#
#   npx eas-cli env:create --name GEMINI_API_KEY --value "<key>" --environment production
#
# or add non-secret values to a build profile's "env" block in eas.json.
# Secrets belong in EAS environment variables, never committed to eas.json.
