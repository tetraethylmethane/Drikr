# Project-level npm config. Overrides any user-level ~/.npmrc for this repo only.
#
# legacy-peer-deps=false is load-bearing, not cosmetic.
#
# This machine's user ~/.npmrc sets legacy-peer-deps=true, which makes npm behave
# like npm 6 and skip auto-installing peer dependencies. Several packages here
# declare @react-native/metro-config as a peer (@react-native/community-cli-plugin,
# react-native-worklets), so a lockfile generated with that setting silently omits
# that whole subtree.
#
# EAS Build runs with default npm config, so its ideal tree includes those peers and
# `npm ci` rejects the lockfile:
#
#   npm error Missing: @react-native/metro-config@0.86.3 from lock file
#
# That failed two Android builds while `npm ci` passed locally, because the same
# user setting applied to both. Pinning it here keeps local installs and EAS in
# agreement. Regenerate the lockfile if you change this.
legacy-peer-deps=false
